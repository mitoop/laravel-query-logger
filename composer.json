{
    "name": "mitoop/laravel-query-logger",
    "description": "Log executed SQL queries to a Laravel log channel.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11|^12|^13"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mitoop\\LaravelQueryLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mitoop\\LaravelQueryLogger\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "mitoop",
            "email": "me@mitoop.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": ["Mitoop\\LaravelQueryLogger\\ServiceProvider"]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint"
    }
}
